# Copy to server/.env and edit.
PORT=4000

# MongoDB (local or Atlas). If empty/unreachable the app falls back to in-memory storage.
MONGODB_URI=mongodb://127.0.0.1:27017/interview-room

# Judge0. Default is the free public CE instance (rate limited, no key needed).
JUDGE0_URL=https://ce.judge0.com
# For RapidAPI-hosted Judge0 instead, set:
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Optional: public base URL used when building invite links (set when deployed).
# PUBLIC_URL=https://your-app.onrender.com
